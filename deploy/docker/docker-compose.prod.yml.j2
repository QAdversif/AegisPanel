#
# Aegis panel — production Docker stack.
#
# v0.5.0+#124 follow-up: this is a Jinja2 template,
# rendered by the `install_panel` Ansible role to
# `/etc/aegis/docker-compose.prod.yml` on the target
# host. The image tag is a variable, not an env
# substitution, so the rendered compose is
# deterministic and `docker compose pull` / `up`
# do not need a per-invocation env var.
#
# This compose runs the Aegis panel container only.
# The data services (Postgres, Redis, NATS) are
# assumed to be running OUTSIDE this stack —
# either on the same host via systemd, or as
# managed services (RDS, ElastiCache, etc.). The
# panel's DSN / Addr env vars are wired to those
# external services by the operator (the sops+age
# secrets file has `aegis.postgres_dsn` for the
# full URL).
#
# The sops+age indirection from #119 means the
# panel's secret env vars (JWT signing key, admin
# password, DB password, agent bearer, panel
# paths) are decrypted by the `configure_secrets`
# role to `/etc/aegis/secrets.env` (mode 0600,
# owner aegis-deploy). The panel container reads
# that file via `env_file:` so the env is mounted
# read-only into the container, never written
# back to the host.
#
# Why `env_file:` and not `environment:` / inline
# `env:`:
#   - `environment:` (inline YAML) is committed
#     to the repo. We never put a secret in the
#     inline block.
#   - `env_file:` references a file. The
#     canonical path (`/etc/aegis/secrets.env`)
#     is on the host, not in the compose
#     project's working directory; the
#     `required: true` flag fails the bring-up
#     if the file is missing.
#
# How to deploy (after `configure_secrets` has
# run):
#   docker compose -f /etc/aegis/docker-compose.prod.yml pull
#   docker compose -f /etc/aegis/docker-compose.prod.yml up -d
#
# (Or via the `install_panel` Ansible role, which
# is the canonical path.)

services:
  panel:
    image: ghcr.io/qadversif/aegispanel:{{ aegis_panel_image_tag | default('latest') }}
    container_name: aegis-panel
    # The distroless base image does not ship a
    # shell, so `docker exec` for diagnostics is
    # restricted to the ENTRYPOINT; logs come
    # through journald / the docker log driver.
    entrypoint: ["/app/aegis"]
    restart: unless-stopped
    # Pull the secrets in as read-only env vars.
    # The file is mode 0600 on the host; docker
    # passes the same mode through the bind
    # mount, and the container reads it as the
    # nonroot user (uid 65532 in distroless).
    # The mount is RO so a process that escapes
    # the panel cannot tamper with the file.
    env_file:
      - path: /etc/aegis/secrets.env
        required: true
    # Production runs behind a reverse proxy
    # (Caddy) on the same host. The compose file
    # does NOT publish 8080 to the public
    # interface; the install_caddy role (in
    # v0.5.0+) handles the proxy. For now the
    # port is left published on the loopback so
    # the reverse proxy can reach the panel.
    ports:
      # Loopback only — the reverse proxy
      # (Caddy or any other) is the public
      # ingress. The publish on
      # 127.0.0.1:8080:8080 is the only
      # published form.
      - "127.0.0.1:8080:8080"
    # The panel reads migrations from the
    # bundled directory at startup; the
    # migrations path is /app/migrations on the
    # distroless image. No host volume for
    # migrations in v0.5.0 (the panel's built-in
    # migrator reads /app/migrations; see
    # `internal/migrations`). The host bind
    # mount is reserved for the /var/lib/aegis
    # backups dir on the next GA-prep PR.
    volumes:
      - /var/lib/aegis:/var/lib/aegis:rw
    # The panel needs to talk to Postgres /
    # Redis / NATS on the host's loopback (or
    # via a sidecar network). In the v0.5.0
    # production layout, the data services
    # are managed externally and the panel
    # reaches them over `host.docker.internal`
    # on macOS or `172.17.0.1` on Linux. The DSN
    # env vars in /etc/aegis/secrets.env are
    # pre-formatted with the correct host by the
    # operator (the secrets file has
    # `aegis.postgres_dsn` for the full URL).
    extra_hosts:
      - "host.docker.internal:host-gateway"
    # Health check. Distroless has no `wget` or
    # `curl`, and the panel's ENTRYPOINT is
    # `/app/aegis` (no shell). A v0.5.x
    # follow-up will ship a tiny healthcheck
    # binary inside the image; for now the
    # healthcheck is left to the reverse proxy
    # (Caddy polls the panel's /healthz
    # endpoint and pulls the container out of
    # the LB on consecutive 5xx).
    # healthcheck: { ... } — intentionally omitted.
