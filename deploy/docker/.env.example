# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Aegis environment — example secrets.
# Copy this file to `deploy/docker/.env` and fill in real values.
#
# This file is the canonical list of every AEGIS_* environment variable
# the panel reads (as of v0.8.25). Variables marked `required` MUST be set
# for `AEGIS_ENV=production` boot. Variables marked `dev-only` are only
# read in `AEGIS_ENV=development` / `staging`; production deployments
# should leave them at the default or empty.
#
# Reference: `backend/internal/config/config.go` (the `Config` struct
# is the source of truth for `env` tags). `docs/RUNBOOKS/deploy.md`
# has the operator walkthrough.
#
# Generate the JWT secret with:   openssl rand -hex 32
# Generate the path secret with:  openssl rand -hex 16

# ===== Core =================================================================

# development | staging | production
AEGIS_ENV=development
AEGIS_HTTP_ADDR=:8080
AEGIS_SHUTDOWN_TIMEOUT=30s
AEGIS_GIT_COMMIT=dev
AEGIS_BUILD_TIME=
AEGIS_LOG_LEVEL=info

# 32+ char random secret for signing access tokens.
# Generate with: openssl rand -hex 32
AEGIS_JWT_SECRET=replace-me-with-openssl-rand-hex-32

# Public sub-path prefix for the panel UI/API (anti-scraping measure;
# derives `/s3cr3t-p4n3l-<hex>` and `/s3cr3t-sub-<hex>`).
# If AEGIS_PATH_SECRET is empty, an auto-generated value is used.
AEGIS_PATH_SECRET=

# ===== Stores (11 AEGIS_*_BACKEND=pg for production) =======================

# Required for production. Each *_BACKEND is memory|pg. The v0.8.6+
# Config.validate() guard refuses to boot in AEGIS_ENV=development with
# any *_BACKEND=pg (the silent-misconfig → loud-boot-error fix).
AEGIS_AUTH_BACKEND=memory
AEGIS_HOSTS_BACKEND=memory
AEGIS_NODES_BACKEND=memory
AEGIS_INBOUNDS_BACKEND=memory
AEGIS_SUBSCRIPTION_BACKEND=memory
AEGIS_USERS_BACKEND=memory
AEGIS_PLANS_BACKEND=memory
AEGIS_WEBHOOKS_BACKEND=memory
AEGIS_PANELCFG_BACKEND=memory
AEGIS_AUDITS_BACKEND=memory
AEGIS_CREDENTIALS_BACKEND=memory
# AEGIS_INBOUND_TEMPLATES_BACKEND is in v0.8.13+ (migration 0021).
# Add when the inbound-templates feature is enabled in your env.
# AEGIS_INBOUND_TEMPLATES_BACKEND=memory
# AEGIS_SECRETS_BACKEND is `sops` only — see Secrets section below.
AEGIS_SECRETS_BACKEND=sops

# ===== Webhooks (sops+age envelope on webhook_endpoints.secret) ===========

# AEGIS_WEBHOOKS_BACKEND=pg → these two vars are required.
# Recipient format: comma-separated `age1...` keys (multi-recipient for
# key rotation; one recipient per operator).
AEGIS_WEBHOOKS_SECRET_AGE_RECIPIENTS=***REMOVED***
# Path to the panel's age identity file on the host. The distroless
# nonroot UID 65532 reads this file — chown 65532:65532 / chmd 0640
# required (see docs/RUNBOOKS/deploy.md §6.2).
AEGIS_WEBHOOKS_SECRET_AGE_KEY_FILE=/etc/aegis/age.key

# Webhook retry worker (background goroutine). Default true, 5s interval.
AEGIS_WEBHOOKS_RETRY_WORKER_ENABLED=true
AEGIS_WEBHOOKS_RETRY_WORKER_INTERVAL=5s

# ===== Bootstrap (SSH + agent install) =====================================

# Path to the aegis-agent binary inside the panel container. v0.8.15+
# multi-stage Dockerfile copies it to /app/bin/aegis-agent. The default
# "./bin/aegis-agent" is the dev-mode path (the binary is built by
# `make dev` into the local `bin/`).
AEGIS_AGENT_BINARY=/app/bin/aegis-agent
AEGIS_AGENT_SSH_PORT=22
AEGIS_AGENT_SSH_USER=root

# Path to the panel's known_hosts file (TOFU-pinned host keys).
# The mount is host: /var/lib/aegis/known_hosts → container:
# /var/lib/aegis/known_hosts (chmod 0666 required — the nonroot
# container can't create new files in the parent dir; see
# KNOWN_LIMITATIONS.md "known_hosts temp-file creation").
AEGIS_AGENT_KNOWN_HOSTS=/var/lib/aegis/known_hosts

# ===== Backups =============================================================

AEGIS_BACKUPS_DIR=./var/backups
AEGIS_BACKUPS_ALLOW_UI_RESTORE=false
AEGIS_BACKUPS_RETENTION_DAYS=30
AEGIS_BACKUPS_MAX_COUNT=0
# AEGIS_BACKUPS_CRON is intentionally empty in dev (manual
# POST /api/v1/backups/). Production should set this to a cron
# expression (e.g. "0 2 * * *" for daily 02:00 UTC). v0.9.0
# candidate wires BackupScheduler goroutine.
AEGIS_BACKUPS_CRON=

# ===== Subscription rate limit (per-token) =================================

AEGIS_SUBSCRIPTION_RATELIMIT_RPS=1
AEGIS_SUBSCRIPTION_RATELIMIT_BURST=5
AEGIS_SUBSCRIPTION_RATELIMIT_MAX_KEYS=50000

# ===== Batched Applier ======================================================

AEGIS_BATCHED_APPLIER_ENABLED=true

# ===== Secrets (sops+age, decrypt-on-operator) ===========================

AEGIS_SECRETS_FILE=/run/aegis/secrets.enc.yaml
# sops+age envelope is the only supported path for AEGIS_SECRETS_BACKEND.
# Operator workflow: SOPS_AGE_KEY_FILE=… sops -d secrets.enc.yaml →
# python env-flag builder → docker run -e KEY=VALUE.
# See docs/RUNBOOKS/deploy.md §6.3.

# ===== Caddy (panel side) ==================================================

AEGIS_CADDY_ADMIN_URL=http://caddy:2019
AEGIS_DECOY_ROOT=/var/www/decoy

# Public domain the panel will be served from.
AEGIS_PANEL_DOMAIN=panel.aegis.local
AEGIS_PANEL_EMAIL=admin@aegis.local

# Cloudflare DNS-01 token (optional). Leave empty in dev to use the
# internal ACME http-01 challenge.
AEGIS_CLOUDFLARE_API_TOKEN=

# ===== Observability =======================================================

# Path under which the panel exposes Prometheus metrics.
AEGIS_METRICS_PATH=/metrics

# ===== Infrastructure =======================================================

POSTGRES_USER=aegis
POSTGRES_PASSWORD=replace-me-postgres
POSTGRES_DB=aegis
AEGIS_POSTGRES_DSN=postgres://aegis:replace-me-postgres@postgres:5432/aegis?sslmode=disable

AEGIS_REDIS_ADDR=redis:6379
AEGIS_REDIS_DB=0

AEGIS_NATS_URL=nats://nats:4222

AEGIS_CLICKHOUSE_DSN=clickhouse://aegis:replace-me-clickhouse@clickhouse:9000/aegis

# ===== Dev-only ============================================================

# AEGIS_ENV=development: the *_BACKEND=pg guard is a hard error.
# AEGIS_ENV=staging|production: allowed. Use staging for the
# pre-prod panel; production is the public-facing deploy.

# ClickHouse is optional (Phase 1+ v1.8+); leave the DSN empty to
# disable ClickHouse-dependent features (the panel won't try to
# connect if the URL is empty).
