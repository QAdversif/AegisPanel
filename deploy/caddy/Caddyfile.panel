# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Caddyfile for the Aegis panel.
#
# Architecture context: ARCHITECTURE.md §15, §19.4, §26.
#
# Behaviour:
#   * Random "secret" admin path   → Aegis backend (Vue SPA + API)
#   * Random "secret" sub path     → Aegis backend (subscription endpoint)
#   * /healthz                     → backend
#   * everything else               → decoy site
#
# The two secret paths are auto-generated on first boot and written to
# /etc/aegis/panel.env. They are referenced here as environment
# placeholders that Caddy's admin API rewrites at runtime.

{
    email {$AEGIS_PANEL_EMAIL:admin@panel.aegis.local}
    acme_dns cloudflare {env.AEGIS_CLOUDFLARE_API_TOKEN}
    admin localhost:2019
}

{$AEGIS_PANEL_DOMAIN:panel.aegis.local} {

    # Aegis admin SPA + API. Mounted under a random path so the
    # default URL doesn't leak "this is a VPN panel".
    @admin_path path /s3cr3t-p4n3l-*/*
    handle @admin_path {
        reverse_proxy aegis-backend:8080
        encode gzip zstd
        header {
            Strict-Transport-Security "max-age=31536000; includeSubDomains"
            X-Content-Type-Options "nosniff"
            X-Frame-Options "DENY"
            Referrer-Policy "strict-origin-when-cross-origin"
            # v0.8.13+ Content-Security-Policy — the
            # third leg of the external-audit 3.1 fix
            # (XSS defense-in-depth). The HttpOnly cookie
            # from PR #214 already closed the "stolen
            # credential" attack surface; this CSP
            # closes the "injected script" surface.
            #
            # Directives:
            #   * default-src 'self' — only same-origin
            #     resources. Catches the case where an
            #     injected <img src="evil.com/x"> tries
            #     to phone home.
            #   * script-src 'self' — no inline scripts.
            #     Vue 3 + Vite/rolldown production build
            #     inlines no scripts; the only allowed
            #     source is the hashed /assets/*.js bundles.
            #   * style-src 'self' 'unsafe-inline' — Vue 3
            #     uses runtime CSS-in-JS (useCssVars +
            #     scoped style injection in some
            #     components) that ends up as inline
            #     style= on the rendered element. The
            #     'unsafe-inline' trade-off is documented
            #     in the v0.8.13 release notes; a future
            #     v0.8.x+ can move to nonce-based CSP
            #     (per-request nonce generated by a small
            #     Caddy snippet) for full strict-dynamic.
            #   * img-src 'self' data: — SVG icons inlined
            #     as data URIs (the panel's icon set is
            #     data-URI; a stricter policy would break
            #     the empty-state illustrations).
            #   * connect-src 'self' — XHR/fetch targets
            #     are same-origin /api/v1. The
            #     decoy site (also same-origin) is
            #     unaffected because it has no fetch
            #     targets.
            #   * frame-ancestors 'none' — no framing.
            #     This is the CSP-level equivalent of
            #     X-Frame-Options: DENY (CSP3 standard,
            #     works in all evergreen browsers).
            #   * base-uri 'self' — prevent <base> tag
            #     hijacking. The panel has no <base>
            #     tag, but a defence-in-depth zero
            #     closes the angle.
            #   * form-action 'self' — form targets stay
            #     same-origin. The panel's only <form>
            #     is the login form, which POSTs to
            #     /api/v1/auth/login on the same
            #     origin.
            #   * object-src 'none' — no Flash / Java
            #     applets / <embed>. Defensive default
            #     even though the panel has none.
            Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
    }

    # Subscription endpoint. Same trick — separate secret path so a
    # scrape of /api/v1/users doesn't reveal the admin URL.
    @sub_path path /s3cr3t-sub-*/*
    handle @sub_path {
        reverse_proxy aegis-backend:8080
    }

    # Liveness + readiness.
    handle /healthz {
        reverse_proxy aegis-backend:8080
    }

    # Prometheus metrics, with basic auth (placeholder).
    @metrics path /metrics
    handle @metrics {
        basicauth {
            aegis $2a$14$replace-me-with-real-bcrypt
        }
        reverse_proxy aegis-backend:8080
    }

    # Decoy site: the default behaviour. Anyone probing the panel
    # domain gets the operator-supplied HTML, not the admin UI.
    handle /* {
        root * /var/www/decoy/panel
        file_server
        encode gzip zstd
        header {
            X-Content-Type-Options "nosniff"
            X-Frame-Options "SAMEORIGIN"
        }
    }

    log {
        output file /var/log/caddy/panel-access.log {
            roll_size 50MiB
            roll_keep 5
        }
        format json
    }
}
