# --- Aegis monorepo .gitignore ---

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
*.iml
.DS_Store?

# Secrets & local config
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
config/local.*

# The bare `secrets/` rule was removed in PR #119.
# Old top-level `secrets/` was an unnamed catch-all
# for ad-hoc local files. The new `deploy/secrets/`
# is the canonical home for sops-encrypted secrets
# and is committed (with per-directory gitignore
# controlling what plaintext is allowed locally).

# --- Go ---
backend/bin/
backend/dist/
backend/coverage/
backend/*.out
backend/vendor/
backend/.golangci-cache/
*.test
*.prof

# --- Vue / Node / pnpm ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/.cache/
frontend/.nuxt/
docs/node_modules/
docs/.vuepress/.cache/
docs/.vuepress/.temp/
docs/.vuepress/dist/
.pnpm-store/
node_modules/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Ansible ---
deploy/ansible/.vault_pass
deploy/ansible/*.retry
deploy/ansible/roles/*/.vault_pass
*.pyc
__pycache__/

# --- Docker / dev volumes ---
deploy/docker/.volumes/
deploy/docker/postgres-data/
deploy/docker/redis-data/
deploy/docker/nats-data/
deploy/docker/clickhouse-data/
deploy/docker/caddy-data/

# --- Caddy ---
deploy/caddy/*.bak
deploy/caddy/acme/

# --- Build / coverage artefacts ---
*.tar.gz
*.zip
dist/
build/
out/
coverage/
.nyc_output/

# --- Test artefacts ---
playwright-report/
test-results/
.vitest-cache/

# --- Local node / cert storage (real deployments) ---
deploy/caddy/data/
deploy/caddy/config/
deploy/caddy/letsencrypt/

# --- Editor workspace ---
*.code-workspace
.idea/

# --- Generated docs (when built) ---
docs/.vuepress/dist/
docs/.vuepress/.cache/

# --- Local debug logs ---
*.log
logs/
*.pid
*.seed
*.pid.lock

# --- Backup files ---
*.bak
*.swp
*.tmp
*.orig
*.rej

# --- Throwaway local files (commit message drafts, temp scripts) ---
# These patterns match the throwaway file convention
# documented in agent memory: every PR cycle creates
# `.git-commit-<name>.txt` (commit-message draft) and
# `.tmp-*.py` (helper script); both must be mavis-trash'd
# before `git add`. The .github/pr-body-<name>.md files
# are tracked intentionally (see PR body convention).
.git-commit-*.txt
.tmp-*.py
.tmp-*.log
.tmp-*.json
.tmp-*.sh

# --- Operator deploy scripts (live in the repo path but are
# operator-only; contain VPS IP, SSH pubkey, DB password,
# container names, panel sub-path, etc. — see
# ~/.aegis/deploy.local.md for the canonical private notes).
# Tracked-by-accident is a hard fail because git history is
# world-readable after the repo is public. Pattern matches
# every `aegis-*.{py,sh}` under tools/scripts/; if a future
# commit needs to add a shared, non-secret helper there, it
# should be NAMED differently (e.g. `panel-healthcheck.py`).
tools/scripts/aegis-*.py
tools/scripts/aegis-*.sh

# --- Generated keys / certs (sandbox only) ---
*.csr
*.crt
*.key
*.p12
*.pfx

# --- sops+age secrets (PR #119) ---
# Per the `Secrets via sops+age` section of
# `docs/operator-guide.md`: the age *private* key
# (`age.key`) is the most sensitive artefact in the
# deploy chain — losing it loses every encrypted
# secret. The `*.example.*` / `*.enc` files are safe
# to commit (encrypted blobs); the `secrets.yml`
# plaintext must never reach the repo. Both `*.key`
# and `*.pem` above already catch most forms; the
# explicit `age.key` rule below is for the no-suffix
# default path that `age-keygen` produces.
age.key
age-*.key
deploy/secrets/secrets.yml
deploy/secrets/secrets.local.yml

# --- Aegis safety bundles ---
backups/
