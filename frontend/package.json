{
  "name": "aegis-ui",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Aegis admin UI — Vue 3 + TypeScript + Vite",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && node tools/scripts/check-raw-text.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,json,css,scss,md}\"",
    "type-check": "vue-tsc --noEmit",
    "codegen": "openapi-typescript ../docs/openapi.yaml -o src/types/api.d.ts",
    "codegen:check": "node tools/scripts/check-codegen.mjs"
  },
  "dependencies": {
    "@tanstack/vue-table": "^8.21.3",
    "@vee-validate/zod": "^4.15.1",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^11.3.0",
    "axios": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.2",
    "radix-vue": "^1.9.17",
    "tailwind-merge": "^3.6.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.40",
    "vue-i18n": "^10.0.5",
    "vue-router": "^5.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.12.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "10.5",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "8.5",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "tailwindcss": "3.4",
    "tailwindcss-animate": "1.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.1.10"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "brace-expansion": "^5.0.8",
    "js-yaml": "^4.3.0"
  }
}
